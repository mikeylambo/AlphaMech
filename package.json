{
  "name": "blinkfall",
  "private": true,
  "version": "0.3.0",
  "type": "module",
  "scripts": {
    "dev": "vite --port 5180 --strictPort",
    "build": "tsc --noEmit && vite build",
    "preview": "vite preview --port 5181",
    "verify": "tsc --noEmit",
    "profile": "vite build && node tools/profile.mjs --preview",
    "gates": "node tools/v03.mjs && node tools/content.mjs && node tools/variants.mjs && node tools/loop.mjs && node tools/lifecycle.mjs && node tools/fallcheck.mjs && node tools/gravemark.mjs && node tools/onboarding.mjs && node tools/settings.mjs",
    "ladder": "node tools/ladder.mjs"
  },
  "dependencies": {
    "@fontsource/barlow-condensed": "^5.3.0",
    "@fontsource/ibm-plex-mono": "^5.3.0",
    "three": "0.180.0"
  },
  "devDependencies": {
    "@types/three": "0.180.0",
    "typescript": "^5.6.0",
    "vite": "^5.4.0"
  }
}
